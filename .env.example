# =============================================================================
# AegisNet Protocol Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# 1. NETWORK & DEPLOYMENT KEYS
# -----------------------------------------------------------------------------
# Ethereum Sepolia RPC URL (Alchemy Endpoint)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY_HERE

# EVM Chain ID (11155111 for Sepolia)
CHAIN_ID=11155111

# Deployer / Protocol Owner Private Key
PRIVATE_KEY=YOUR_DEPLOYER_PRIVATE_KEY_HERE

# Dedicated Approval Relayer Private Key (separate from deployer/owner)
RELAYER_PRIVATE_KEY=YOUR_RELAYER_PRIVATE_KEY_HERE

# Root ENS Domain Name registered on Sepolia
ENS_ROOT_NAME=aegisnet.eth


# -----------------------------------------------------------------------------
# 2. DEPLOYED CONTRACT ADDRESSES (Sepolia Testnet)
# -----------------------------------------------------------------------------
CONTRACT_REGISTRY=0x6Dbd89B71e8AB7BF93a9200C6fB81951699549FE
CONTRACT_EXECUTION_MANAGER=0x13d7b8Add8265AB1Cfdc3a6E8E60D1b3bcD56fa8
CONTRACT_SWAPVM_ADAPTER=0xb81b7Ec40eF275AA805Cb82D729498C47Ab64c60
CONTRACT_UNISWAP_ADAPTER=0xD855719f7Cc2cD867540F8398E3d2Fa4b2dD8221


# -----------------------------------------------------------------------------
# 3. HUMAN APPROVAL GATEWAY CONFIGURATION
# -----------------------------------------------------------------------------
# Dollar threshold triggering human clearance ($1,000 USD default)
BIOMETRIC_THRESHOLD_USD=1000

# World ID / Human Auth credentials (wired for human approval)
WORLD_ID_APP_ID=app_staging_aegisnet_2026
WORLD_ID_ACTION=agent-high-value-auth
WORLD_ID_VERIFY_MODE=dev


# -----------------------------------------------------------------------------
# 4. BACKEND SERVER & HOSTING
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:3000

# Optional Admin API Key for protected endpoints
ADMIN_API_KEY=YOUR_ADMIN_API_KEY_HERE


# -----------------------------------------------------------------------------
# 5. EXTERNAL INTEGRATIONS & AI
# -----------------------------------------------------------------------------
# 1inch Developer Portal API Key
ONEINCH_API_KEY=YOUR_1INCH_API_KEY_HERE

# Anthropic API Key for Claude AI Strategy Planner (Optional)
ANTHROPIC_API_KEY=

# Anthropic Claude model version
CLAUDE_MODEL=claude-opus-5

# Data directory
DATA_DIR=./data


# -----------------------------------------------------------------------------
# 6. 0G DECENTRALIZED AI COMPUTE & STORAGE
# -----------------------------------------------------------------------------
# AI Strategy Planner Provider: 0g (default) or claude
PLANNER_PROVIDER=0g

# 0G Private Compute / Router API Key
ZG_COMPUTE_API_KEY=YOUR_0G_COMPUTE_API_KEY_HERE

# 0G Compute Router Endpoint (OpenAI-compatible)
ZG_COMPUTE_ENDPOINT=https://router-api.0g.ai/v1

# 0G Compute Model Name
ZG_COMPUTE_MODEL=0gm-1.0-35b-a3b

# 0G Storage Indexer RPC (Galileo Testnet Turbo or Mainnet)
ZG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai

# 0G Storage EVM RPC
ZG_STORAGE_RPC=https://evmrpc-testnet.0g.ai

# Dedicated Private Key for 0G Storage fee settlement (uses deployer key if blank)
ZG_STORAGE_PRIVATE_KEY=YOUR_0G_STORAGE_PRIVATE_KEY_HERE

