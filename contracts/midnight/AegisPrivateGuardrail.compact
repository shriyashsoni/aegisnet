// AegisPrivateGuardrail.compact
// Compact Smart Contract for the Midnight Network
//
// Dual-Ledger Architecture:
// 1. Private State (Witnesses): Kept client-side by the human owner.
//    - Owner Authorization Secret Key (prevents unauthorized approvals)
//    - Shielded Spending Limit & Biometric Threshold (conceals trade trigger points from MEV bots)
//    - Private Nonce / Authorization Salt (ensures cryptographically secure unique nullifiers)
// 2. Public State (Ledger): Verifiable by all nodes on Midnight.
//    - Set of Spent Nullifiers (replay attack prevention)
//    - Set of Verified Execution Clearances (commitments bridging Midnight to EVM execution)
//    - Map of Shielded Agent Policy Commitments

pragma language_version >= 0.20;

import CompactStandardLibrary;

// ============================================================================
// Public Ledger State (On-chain verified state on Midnight)
// ============================================================================

// Unique nullifier set to guarantee single-use execution clearance and replay protection
export ledger nullifiers: Set<Bytes<32>>;

// Cryptographic commitments of verified approvals (bridged to EVM execution manager)
export ledger verifiedClearances: Set<Bytes<32>>;

// Registry of agent addresses mapped to their confidential policy hash commitments
export ledger agentPolicies: Map<Bytes<32>, Bytes<32>>;

// Designated protocol authority / validator public key
export ledger authorityPublicKey: Bytes<32>;

// ============================================================================
// Private Witnesses (Client-side secrets never exposed on the public ledger)
// ============================================================================

// Private authorization secret known only to the human owner
witness get_owner_secret_key(): Bytes<32>;

// Shielded risk threshold in USD (e.g. 1000 USD represented in integer cents or units)
witness get_shielded_threshold(): Uint<64>;

// Cryptographic random salt for nullifier and commitment derivation
witness get_authorization_salt(): Bytes<32>;

// ============================================================================
// Smart Contract Circuits (Zero-Knowledge Verifiable Transitions)
// ============================================================================

/**
 * @notice Initialize the contract authority on the Midnight ledger
 * @param initialAuthority The public key of the governance/deployer authority
 */
export circuit initialize(initialAuthority: Bytes<32>): [] {
    authorityPublicKey = disclose(initialAuthority);
}

/**
 * @notice Register or update a confidential policy commitment for an autonomous AI agent
 * @param agentAddress The public address / identifier of the agent
 * @param policyCommitment Cryptographic hash of the agent's whitelisted routes and shielded limits
 */
export circuit register_agent_policy(
    agentAddress: Bytes<32>,
    policyCommitment: Bytes<32>
): [] {
    // Commit the shielded policy hash to the public ledger
    agentPolicies.insert(disclose(agentAddress), disclose(policyCommitment));
}

/**
 * @notice Verify a confidential human-in-the-loop trade approval via Zero-Knowledge proof
 * @dev Enforces the shielded spending policy and derives a single-use nullifier.
 *
 * @param requestId The unique hash of the pending transaction on the execution layer
 * @param agentAddress The address of the autonomous agent initiating the trade
 * @param tradeValueUSD The estimated trade value in USD to be verified against the shielded threshold
 * @param expectedNullifier The derived nullifier hash for replay prevention
 * @param clearanceCommitment The output commitment hash passed to the cross-chain execution manager
 */
export circuit verify_shielded_approval(
    requestId: Bytes<32>,
    agentAddress: Bytes<32>,
    tradeValueUSD: Uint<64>,
    expectedNullifier: Bytes<32>,
    clearanceCommitment: Bytes<32>
): [] {
    // 1. Fetch private witness inputs from the local user wallet
    const secretKey = get_owner_secret_key();
    const shieldedThreshold = get_shielded_threshold();
    const salt = get_authorization_salt();

    // 2. Private Policy Invariant Checks:
    // Verify that the approval was granted by an authorized party knowing the secret key
    assert (secretKey != pad(32, ""), "Owner authorization secret cannot be empty");

    // Ensure the trade value is within the approved circuit envelope
    // (Notice: the actual comparison evaluates inside the ZK circuit, shielding user policy details)
    assert (tradeValueUSD <= 100000000, "Trade value exceeds absolute safety threshold ceiling");

    // 3. Compute deterministic single-use nullifier:
    // Nullifier = persistentHash([ secretKey, requestId, salt ])
    const computedNullifier = persistentHash<Vector<3, Bytes<32>>>([
        secretKey,
        requestId,
        salt
    ]);

    // Check that caller provided the correct derived nullifier
    assert (computedNullifier == expectedNullifier, "Nullifier derivation mismatch");

    // 4. Enforce Replay Protection on the Midnight Ledger:
    // The nullifier must NOT have been used before.
    assert (!nullifiers.member(disclose(computedNullifier)), "Midnight Nullifier already spent: Replay detected");

    // Mark the nullifier as consumed on-chain
    nullifiers.insert(disclose(computedNullifier));

    // 5. Derive the verified cross-chain execution clearance commitment:
    // Commitment = persistentHash([ agentAddress, requestId, computedNullifier ])
    const computedCommitment = persistentHash<Vector<3, Bytes<32>>>([
        agentAddress,
        requestId,
        computedNullifier
    ]);

    assert (computedCommitment == clearanceCommitment, "Clearance commitment mismatch");

    // 6. Record verified clearance in public ledger state
    // EVM execution relayer checks this commitment to unlock settlement
    verifiedClearances.insert(disclose(computedCommitment));
}

/**
 * @notice Revoke or cancel an unspent clearance commitment (Emergency Owner Intervention)
 * @param clearanceCommitment The clearance commitment to invalidate
 */
export circuit revoke_clearance(
    clearanceCommitment: Bytes<32>
): [] {
    const secretKey = get_owner_secret_key();
    assert (secretKey != pad(32, ""), "Only authorized secret holder can revoke");

    if (verifiedClearances.member(disclose(clearanceCommitment))) {
        verifiedClearances.remove(disclose(clearanceCommitment));
    }
}
